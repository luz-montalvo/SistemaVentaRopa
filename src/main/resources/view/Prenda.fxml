<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.sysventas.controller.PrendaController">

    <children>

        <VBox spacing="10.0"
              AnchorPane.topAnchor="10.0"
              AnchorPane.bottomAnchor="10.0"
              AnchorPane.leftAnchor="10.0"
              AnchorPane.rightAnchor="10.0">

            <children>

                <!-- TÍTULO -->
                <Label text="Gestionar Prendas">
                    <style>
                        -fx-font-size: 20px;
                        -fx-font-weight: bold;
                    </style>
                </Label>


                <!-- FORMULARIO -->
                <GridPane hgap="10.0"
                          vgap="3.0">

                    <padding>
                        <Insets top="10.0"
                                right="10.0"
                                bottom="10.0"
                                left="10.0"/>
                    </padding>

                    <children>

                        <!-- NOMBRE -->
                        <Label text="Nombre:"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="txtNombre"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"
                                   prefWidth="220.0"/>

                        <Label fx:id="lblNombreError"
                               text=""
                               style="-fx-text-fill: red; -fx-font-size: 11px;"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>


                        <!-- CATEGORÍA -->
                        <Label text="Categoría:"
                               GridPane.rowIndex="2"/>

                        <ComboBox fx:id="cbxCategoria"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="2"
                                  prefWidth="220.0"/>

                        <Label fx:id="lblCategoriaError"
                               text=""
                               style="-fx-text-fill: red; -fx-font-size: 11px;"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="3"/>


                        <!-- TALLA -->
                        <Label text="Talla:"
                               GridPane.rowIndex="4"/>

                        <ComboBox fx:id="cbxTalla"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="4"
                                  prefWidth="220.0"/>

                        <Label fx:id="lblTallaError"
                               text=""
                               style="-fx-text-fill: red; -fx-font-size: 11px;"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="5"/>


                        <!-- COLOR -->
                        <Label text="Color:"
                               GridPane.rowIndex="6"/>

                        <ComboBox fx:id="cbxColor"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="6"
                                  prefWidth="220.0"/>

                        <Label fx:id="lblColorError"
                               text=""
                               style="-fx-text-fill: red; -fx-font-size: 11px;"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="7"/>


                        <!-- PRECIO -->
                        <Label text="Precio:"
                               GridPane.rowIndex="8"/>

                        <TextField fx:id="txtPrecio"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="8"
                                   prefWidth="220.0"/>

                        <Label fx:id="lblPrecioError"
                               text=""
                               style="-fx-text-fill: red; -fx-font-size: 11px;"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="9"/>


                        <!-- STOCK -->
                        <Label text="Stock:"
                               GridPane.rowIndex="10"/>

                        <TextField fx:id="txtStock"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="10"
                                   prefWidth="220.0"/>

                        <Label fx:id="lblStockError"
                               text=""
                               style="-fx-text-fill: red; -fx-font-size: 11px;"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="11"/>

                    </children>

                </GridPane>


                <!-- MENSAJE GENERAL -->
                <Label fx:id="lblMensaje"
                       text=""
                       style="-fx-text-fill: green; -fx-font-weight: bold;"/>


                <!-- BOTONES -->
                <HBox spacing="10.0">

                    <children>

                        <Button text="Guardar"
                                onAction="#guardar"
                                prefWidth="100.0"/>

                        <Button text="Editar"
                                onAction="#editar"
                                prefWidth="100.0"/>

                        <Button text="Limpiar"
                                onAction="#limpiar"
                                prefWidth="100.0"/>

                        <Button text="Eliminar"
                                onAction="#eliminar"
                                prefWidth="100.0"/>

                    </children>

                </HBox>


                <!-- BUSCAR NOMBRE -->
                <HBox spacing="10.0"
                      alignment="CENTER_RIGHT">

                    <children>

                        <Label text="Buscar nombre:"/>

                        <TextField fx:id="txtBuscar"
                                   promptText="Escriba el nombre..."
                                   prefWidth="220.0"/>

                        <Button text="Buscar"
                                onAction="#buscar"
                                prefWidth="100.0"/>

                    </children>

                </HBox>


                <!-- TABLA -->
                <TableView fx:id="tableView"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="80.0"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="150.0"/>

                        <TableColumn fx:id="colCategoria"
                                     text="Categoría"
                                     prefWidth="120.0"/>

                        <TableColumn fx:id="colTalla"
                                     text="Talla"
                                     prefWidth="80.0"/>

                        <TableColumn fx:id="colColor"
                                     text="Color"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="colPrecio"
                                     text="Precio"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="colStock"
                                     text="Stock"
                                     prefWidth="100.0"/>

                    </columns>

                </TableView>

            </children>

        </VBox>

    </children>

</AnchorPane>