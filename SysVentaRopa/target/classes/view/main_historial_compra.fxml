<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="miContenedor" styleClass="pantalla" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.HistorialCompraController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox>
               <children>
                  <Label styleClass="titulo-pantalla" text="Historial de compras" />
                  <Label styleClass="subtitulo-pantalla" text="Seleccione una compra para ver las prendas que ingresaron." />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox styleClass="total-caja">
               <children>
                  <Label styleClass="total-label" text="N° DE COMPRAS" />
                  <Label fx:id="lblCantidad" styleClass="total-valor" text="0" />
               </children>
            </VBox>
            <VBox styleClass="total-caja,principal">
               <children>
                  <Label styleClass="total-label" text="TOTAL COMPRADO" />
                  <Label fx:id="lblTotal" styleClass="total-valor" text="S/ 0.00" />
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox styleClass="card" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="card-titulo" text="Compras registradas" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label styleClass="campo-label" text="DESDE" />
                  <DatePicker fx:id="dpDesde" onAction="#filtrar" prefWidth="140.0" />
                  <Label styleClass="campo-label" text="HASTA" />
                  <DatePicker fx:id="dpHasta" onAction="#filtrar" prefWidth="140.0" />
                  <TextField fx:id="txtFiltro" onKeyReleased="#filtrar" prefWidth="220.0" promptText="Proveedor o comprobante..." />
                  <Button onAction="#limpiarFiltros" styleClass="btn-secundario" text="Limpiar" />
               </children>
            </HBox>
            <TableView fx:id="tableCompras" VBox.vgrow="ALWAYS">
               <placeholder><Label text="No hay compras registradas" /></placeholder>
            </TableView>
         </children>
      </VBox>
      <VBox prefHeight="240.0" styleClass="card">
         <children>
            <Label fx:id="lblDetalle" styleClass="card-titulo" text="Detalle de la compra" />
            <TableView fx:id="tableDetalle" VBox.vgrow="ALWAYS">
               <placeholder><Label text="Seleccione una compra" /></placeholder>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
