<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="miContenedor" styleClass="pantalla" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.CompraController">
   <children>
      <VBox>
         <children>
            <Label styleClass="titulo-pantalla" text="Registrar compra" />
            <Label styleClass="subtitulo-pantalla" text="Ingreso de prendas compradas a un proveedor. Al registrar, el stock aumenta automáticamente." />
         </children>
      </VBox>

      <HBox spacing="16.0">
         <children>
            <!-- 1. COMPROBANTE -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="card-titulo" text="1. Comprobante del proveedor" />
                  <Label styleClass="campo-label" text="PROVEEDOR" />
                  <ComboBox fx:id="cbxProveedor" maxWidth="Infinity" promptText="Seleccione el proveedor" />
                  <HBox spacing="10.0">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="campo-label" text="TIPO" />
                              <ComboBox fx:id="cbxTipoDoc" maxWidth="Infinity" />
                           </children>
                        </VBox>
                        <VBox prefWidth="80.0" spacing="4.0">
                           <children>
                              <Label styleClass="campo-label" text="SERIE" />
                              <TextField fx:id="txtSerie" promptText="F001" />
                           </children>
                        </VBox>
                        <VBox prefWidth="120.0" spacing="4.0">
                           <children>
                              <Label styleClass="campo-label" text="NÚMERO" />
                              <TextField fx:id="txtNumDoc" promptText="0000123" />
                           </children>
                        </VBox>
                        <VBox prefWidth="140.0" spacing="4.0">
                           <children>
                              <Label styleClass="campo-label" text="FECHA" />
                              <DatePicker fx:id="dpFecha" maxWidth="Infinity" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <!-- 2. PRENDA -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="card-titulo" text="2. Agregar prenda" />
                  <TextField fx:id="txtBuscarProducto" promptText="Escriba el nombre de la prenda y elija de la lista" />
                  <HBox alignment="BOTTOM_LEFT" spacing="12.0">
                     <children>
                        <VBox spacing="4.0">
                           <children>
                              <Label styleClass="campo-label" text="STOCK ACTUAL" />
                              <Label fx:id="lblStock" styleClass="chip" text="-" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="campo-label" text="PRECIO COMPRA (S/)" />
                              <TextField fx:id="txtPrecioCompra" promptText="0.00" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="campo-label" text="CANTIDAD" />
                              <TextField fx:id="txtCantidad" onAction="#agregarPrenda" promptText="1" />
                           </children>
                        </VBox>
                        <Button onAction="#agregarPrenda" styleClass="btn-primario" text="Agregar" />
                     </children>
                  </HBox>
                  <Label fx:id="lblMsg" styleClass="msg-error" text="" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- 3. DETALLE -->
      <VBox styleClass="card" VBox.vgrow="ALWAYS">
         <children>
            <Label styleClass="card-titulo" text="3. Detalle de la compra" />
            <TableView fx:id="tableView" minHeight="180.0" VBox.vgrow="ALWAYS">
               <placeholder><Label text="Aún no se agregaron prendas" /></placeholder>
            </TableView>
         </children>
      </VBox>

      <!-- TOTALES -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
         <children>
            <VBox styleClass="total-caja">
               <children>
                  <Label styleClass="total-label" text="NETO" />
                  <Label fx:id="lblNeto" styleClass="total-valor" text="S/ 0.00" />
               </children>
            </VBox>
            <VBox styleClass="total-caja">
               <children>
                  <Label styleClass="total-label" text="IGV (18 %)" />
                  <Label fx:id="lblIgv" styleClass="total-valor" text="S/ 0.00" />
               </children>
            </VBox>
            <VBox styleClass="total-caja,principal">
               <children>
                  <Label styleClass="total-label" text="TOTAL COMPRA" />
                  <Label fx:id="lblTotal" styleClass="total-valor" text="S/ 0.00" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#cancelarCompra" styleClass="btn-secundario,btn-grande" text="Cancelar" />
            <Button onAction="#registrarCompra" styleClass="btn-exito,btn-grande" text="Registrar compra">
               <HBox.margin><Insets right="4.0" /></HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
